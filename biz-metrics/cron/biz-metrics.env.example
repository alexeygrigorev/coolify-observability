# Copy to /data/biz-metrics/env (mode 0600, root:biz-metrics) on contabo-b.
# DSNs use the read-only biz_ro role for app DBs and biz_rw for the store.
# Never commit real values.
BIZ_METRICS_STORE_DSN=postgresql://biz_rw:__REDACTED__@10.100.0.2:5432/biz_metrics
BIZ_METRICS_CMP_DSN=postgresql://biz_ro:__REDACTED__@10.100.0.2:5432/cmp
BIZ_METRICS_WEBSITE_DSN=postgresql://biz_ro:__REDACTED__@10.100.0.2:5432/website
VM_PUSH_URL=http://10.100.0.1:8428/api/v1/import/prometheus
