# Nightly collect-only rollup on contabo-b, whose system timezone MUST be
# Europe/Berlin. Debian cron schedules using the daemon's system timezone;
# TZ below sets the job environment only. Installer verifies the host zone.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
TZ=Europe/Berlin
30 1 * * * root /data/biz-metrics/run.sh >> /var/log/biz-metrics.log 2>&1
