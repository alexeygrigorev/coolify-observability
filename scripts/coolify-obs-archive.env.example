# Example env for scripts/obs-day-archive.sh — COPY, fill in, NEVER commit.
#
#   sudo cp scripts/coolify-obs-archive.env.example /etc/coolify-obs-archive.env
#   sudo chmod 600 /etc/coolify-obs-archive.env
#
# Secrets: private Drive doc + ~/tmp/secrets/coolify-s3-backup-writer-*.env
# IAM: coolify-s3-backup-writer (prefix coolify/* on dtc-coolify-backups-387546586013)

VM_URL=http://127.0.0.1:8428
VL_URL=http://127.0.0.1:9428
VL_DATA=/data/obs/vl
WORKDIR=/var/tmp/coolify-obs-archive

S3_BUCKET=dtc-coolify-backups-387546586013
S3_PREFIX=coolify/obs
S3_ENDPOINT_URL=https://s3.eu-west-1.amazonaws.com
AWS_DEFAULT_REGION=eu-west-1
AWS_ACCESS_KEY_ID=<S3_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<S3_SECRET_KEY>

# Do NOT rm live VL partitions on v1.15.0 (no /internal/partition/detach).
# Local drop = -retentionPeriod=2d on VM+VL.
DROP_VL_PARTITION=0
