# Alertmanager prod config TEMPLATE — t1493u AC3 routing.
# NEVER commit real SMTP credentials. Installer on contabo-a injects them
# from /etc/msmtprc (root 600) into /data/obs/alertmanager/alertmanager.yml (600).
# Placeholders below are replaced on-host; this file is safe to commit review.
# Real (non-drill) alerts -> prod-real receiver: dev@dtcdev.click only.
# Drills (drill=true label or *_canary alertname) -> dev-only: dev@dtcdev.click.
# Slowness (class A10, f5d8e22b AC3) -> slowness-dev ONLY: dev@dtcdev.click
# from alerts@dtcdev.click (its own SES account) — never prod-real.
# No real prod alert is muted. send_resolved: true on every email_config that
# delivers to dev@dtcdev.click (AC5).

global:
  resolve_timeout: 5m
  # Injected on-host:
  # smtp_smarthost: 'email-smtp.eu-west-1.amazonaws.com:587'
  # smtp_from: 'noreply@datatalks.club'
  # smtp_auth_username: '<from /etc/msmtprc user>'
  # smtp_auth_password: '<from /etc/msmtprc password>'
  # smtp_require_tls: true
  smtp_smarthost: '__SMTP_SMARTHOST__'
  smtp_from: 'noreply@datatalks.club'
  smtp_auth_username: '__SMTP_USER__'
  smtp_auth_password: '__SMTP_PASSWORD__'
  smtp_require_tls: true

route:
  # Default = real alerts (drills fall through to the child routes below).
  receiver: 'prod-real'
  group_by: ['alertname', 'class', 'host']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
  # t1493u AC3: drill alerts never page prod. drill=true label or *canary* name
  # (covers A2_disk_canary, A3_canary_oom, A5_canary_missing).
  - matchers: [ 'drill="true"' ]
    receiver: 'dev-only'
  - matchers: [ 'alertname=~".*canary.*"' ]
    receiver: 'dev-only'
  # t2813u/t2814u: one incident = one mail. A1 probes relay/courses/website,
  # which coolify-healthcheck (contabo-b) and the off-Contabo dead-man already
  # page as ONE grouped service incident with 5-min-green RECOVERED and flap
  # hold (machine-management monitors/incident-gate.sh). A1 stays evaluated and
  # visible in vmalert/Alertmanager/vmui but sends no mail of its own, so the
  # same outage can no longer page twice (and flap four times) from OBS too.
  # Drill/canary routes above keep precedence.
  - matchers: [ 'alertname="A1_https_down"' ]
    receiver: 'obs-log'
  # f5d8e22b AC3: every slowness alert (class A10 — both the prod and the dev
  # p95 rule) pages dev@dtcdev.click ONLY, from alerts@dtcdev.click (its own
  # SES account, injected below), with RECOVERED and repeat <=1/h. Before this
  # route the prod p95 rule fell through to prod-real (alexey@ + dev@) with the
  # global noreply@ sender, violating AC3's "mail ONLY to dev@ from alerts@".
  # Drills keep precedence over this route.
  - matchers: [ 'class="A10"' ]
    receiver: 'slowness-dev'
  # t1885u/3bf25bda (2026-10-29, deployed): remaining warning-severity alerts
  # never page prod either — dev-only visibility, below the A10 route so the
  # dev p95 warning keeps its slowness sender.
  - matchers: [ 'severity="warning"' ]
    receiver: 'dev-only'

receivers:
- name: 'prod-real'
  email_configs:
  - to: 'dev@dtcdev.click'
    send_resolved: true
    headers:
      Subject: '[OBS {{ .Status | toUpper }}] {{ .GroupLabels.alertname }} ({{ .GroupLabels.class }}){{ if .GroupLabels.host }} {{ .GroupLabels.host }}{{ end }}'
    html: |
      {{ range .Alerts }}
      <b>{{ .Status }}</b> {{ .Labels.alertname }} ({{ .Labels.class }}){{ if .Labels.host }} host={{ .Labels.host }}{{ end }}{{ if .Labels.mountpoint }} mount={{ .Labels.mountpoint }}{{ end }}{{ if .Labels.instance }} instance={{ .Labels.instance }}{{ end }}<br>
      {{ .Annotations.summary }}<br>
      {{ .Annotations.description }}<br>
      {{ end }}
    text: |
      {{ range .Alerts }}{{ .Status }} {{ .Labels.alertname }} ({{ .Labels.class }}){{ if .Labels.host }} host={{ .Labels.host }}{{ end }}{{ if .Labels.mountpoint }} mount={{ .Labels.mountpoint }}{{ end }}{{ if .Labels.instance }} instance={{ .Labels.instance }}{{ end }}: {{ .Annotations.summary }} — {{ .Annotations.description }}
      {{ end }}

# t2813u/t2814u: no notification integration on purpose (see A1 route above).
- name: 'obs-log'

- name: 'dev-only'
  email_configs:
  - to: 'dev@dtcdev.click'
    send_resolved: true
    headers:
      Subject: '[OBS {{ .Status | toUpper }}] {{ .GroupLabels.alertname }} ({{ .GroupLabels.class }}){{ if .GroupLabels.host }} {{ .GroupLabels.host }}{{ end }}'
    html: |
      {{ range .Alerts }}
      <b>{{ .Status }}</b> {{ .Labels.alertname }} ({{ .Labels.class }}){{ if .Labels.host }} host={{ .Labels.host }}{{ end }}{{ if .Labels.mountpoint }} mount={{ .Labels.mountpoint }}{{ end }}{{ if .Labels.instance }} instance={{ .Labels.instance }}{{ end }}<br>
      {{ .Annotations.summary }}<br>
      {{ .Annotations.description }}<br>
      {{ end }}
    text: |
      {{ range .Alerts }}{{ .Status }} {{ .Labels.alertname }} ({{ .Labels.class }}){{ if .Labels.host }} host={{ .Labels.host }}{{ end }}{{ if .Labels.mountpoint }} mount={{ .Labels.mountpoint }}{{ end }}{{ if .Labels.instance }} instance={{ .Labels.instance }}{{ end }}: {{ .Annotations.summary }} — {{ .Annotations.description }}
      {{ end }}

# f5d8e22b AC3: slowness receiver. Per-config smarthost/auth/from override the
# globals so mail goes out from alerts@dtcdev.click via its own SES account
# (the same account the probe-leg monitors use), to dev@dtcdev.click ONLY.
- name: 'slowness-dev'
  email_configs:
  - to: 'dev@dtcdev.click'
    from: 'alerts@dtcdev.click'
    smarthost: '__SMTP_ALERTS_SMARTHOST__'
    auth_username: '__SMTP_ALERTS_USER__'
    auth_password: '__SMTP_ALERTS_PASSWORD__'
    send_resolved: true
    headers:
      Subject: '[SLOWNESS {{ .Status | toUpper }}] {{ .GroupLabels.alertname }} ({{ .GroupLabels.class }}){{ if .GroupLabels.host }} {{ .GroupLabels.host }}{{ end }}'
    html: |
      {{ range .Alerts }}
      <b>{{ .Status }}</b> {{ .Labels.alertname }} ({{ .Labels.class }}){{ if .Labels.host }} host={{ .Labels.host }}{{ end }}{{ if .Labels.mountpoint }} mount={{ .Labels.mountpoint }}{{ end }}{{ if .Labels.instance }} instance={{ .Labels.instance }}{{ end }}<br>
      {{ .Annotations.summary }}<br>
      {{ .Annotations.description }}<br>
      {{ end }}
    text: |
      {{ range .Alerts }}{{ .Status }} {{ .Labels.alertname }} ({{ .Labels.class }}){{ if .Labels.host }} host={{ .Labels.host }}{{ end }}{{ if .Labels.mountpoint }} mount={{ .Labels.mountpoint }}{{ end }}{{ if .Labels.instance }} instance={{ .Labels.instance }}{{ end }}: {{ .Annotations.summary }} — {{ .Annotations.description }}
      {{ end }}

inhibit_rules: []
